OpenRecon_package

# iQSM is a separate repo/local clone (see or_qsm's own .gitignore), cloned in only to
# build its own standalone Docker image -- qsm.py never imports or uses it, unlike
# iQSM_Plus. .gitignore doesn't affect Docker's build context, only .dockerignore does, so
# without this it silently added ~187MB of unused content to this image (found when v1.1.8
# came out ~480MB larger than v1.1.3 for no code reason).
iQSM

# iQSM_Plus/vendor and DeepRelaxo/vendor are each that sibling repo's own vendored bet2
# copy, added for their own standalone Docker images -- this Dockerfile already has its
# own explicit `COPY vendor/bet2 /opt/bet2` a few lines below, so copying these too is a
# pure ~119MB-each duplicate of the same binary.
iQSM_Plus/vendor
DeepRelaxo/vendor
